{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.mambo.pedidos",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mambo Pedidos",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=9222 --remote-allow-origins=*"
      }
    ]
  }
}
