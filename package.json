{
  "name": "mambo-pedidos",
  "version": "1.7.1",
  "description": "Mambo Pedidos - Gestor de catalogos y pedidos para perifericos gamer",
  "main": "src/index.html",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "bump": "node scripts/bump-version.js",
    "check:version": "node scripts/bump-version.js --check",
    "test": "node scripts/run-tests.js"
  },
  "keywords": [
    "mambo",
    "pedidos",
    "gaming",
    "perifericos",
    "catalogos",
    "importacion"
  ],
  "author": "Mambo",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "pdfjs-dist": "^3.11.174"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0"
  }
}
